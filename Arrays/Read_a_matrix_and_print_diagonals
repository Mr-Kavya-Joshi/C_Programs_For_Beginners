#include<stdio.h>
int main(){
    int i,j;
    int matr[3][3];
    printf("Enter the elements of the matrix\n");
    for(i=0;i<3;i++){
        for(j=0;j<3;j++){
            scanf("%d",&matr[i][j]);
        }
    }
    printf("The diagonal elements are:\n");
    for(i=0;i<3;i++){
        for(j=0;j<3;j++){
            if (i==j) printf("%d ",matr[i][j]);
        }
    }
    return 0;
}
